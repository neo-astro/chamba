{
  "name": "proconnect-backend",
  "version": "1.0.0",
  "description": "ProConnect Backend - Bun.js + PostgreSQL",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outfile dist/index.js",
    "start": "bun src/index.ts",
    "db:migrate": "bun run database/migrate.ts",
    "db:seed": "psql -d $DATABASE_URL -f database/seed.sql"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "pg": "^8.11.0",
    "jsonwebtoken": "^9.1.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.11.0",
    "@types/jsonwebtoken": "^9.0.5",
    "typescript": "^5.3.3"
  }
}
